# Web app URL of the Google Apps Script that saves Join applications.
# Setup: integrations/google-sheets/README.md
VITE_JOIN_SHEET_URL=

# Contact page email (api/contact.js), sent through Resend: https://resend.com
# These are server-only (no VITE_ prefix), so they never reach the browser.
# Locally: put them in .env.local. On Vercel: Project → Settings → Environment Variables.
RESEND_API_KEY=
# Inbox that receives the messages. Several are allowed, separated by commas.
CONTACT_TO_EMAIL=
# Sender shown on the email. Leave empty to use Resend's test sender, which can
# only deliver to the address of the Resend account; set this to an address on
# a domain verified in Resend (e.g. Genesis <contact@aws-genesis.com>) to send
# to any inbox.
CONTACT_FROM_EMAIL=
